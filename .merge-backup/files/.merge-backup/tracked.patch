+    const auth = process.env.API_PROXY_AUTH ?? "http://127.0.0.1:8001";
+    const search = process.env.API_PROXY_SEARCH ?? "http://127.0.0.1:8003";
+    const research = process.env.API_PROXY_RESEARCH ?? "http://127.0.0.1:8004";
