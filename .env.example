# ==========================================================================
# AI Legal OS - environment template. Copy to .env and adjust for your setup.
# ==========================================================================

# ---- Global ----
ENVIRONMENT=development
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SDK_DISABLED=true

# ---- Security ----
# Generate strong values in production (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
JWT_ALGORITHM=HS256
# 32-byte (64 hex chars) key for AES-256 field encryption.
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=legalos
POSTGRES_PASSWORD=legalos
POSTGRES_DB=legalos

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=legal_knowledge

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=legalos-neo4j

# ---- OpenSearch ----
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_INDEX=legal_documents

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Object storage (S3 / MinIO) ----
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=legalos-documents

# ---- LLM / Embeddings (Google Gemini via OpenAI-compatible API) ----
# Prefer gemini-3.1-pro-preview for quality, or gemini-3.6-flash for speed.
# gemini-2.5-* is unavailable to new API keys.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=replace-me
LLM_MODEL=gemini-3.1-pro-preview
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
# Set to true only for offline stub mode (no real AI). For production / real answers, keep false.
LLM_USE_STUB=false
EMBEDDING_USE_STUB=false
# Fast model used only for query routing (conversational vs legal). Much cheaper than the main model.
LLM_ROUTER_MODEL=gemini-3.6-flash

# ---- Service URLs (inter-service calls) ----
AUTH_SERVICE_URL=http://auth:8001
INGESTION_SERVICE_URL=http://knowledge-ingestion:8002
SEARCH_SERVICE_URL=http://search:8003
RESEARCH_SERVICE_URL=http://research:8004
DOCUMENT_SERVICE_URL=http://document:8005
REASONING_SERVICE_URL=http://reasoning:8006
DRAFTING_SERVICE_URL=http://drafting:8007
CONTRACT_REVIEW_SERVICE_URL=http://contract-review:8008
LITIGATION_SERVICE_URL=http://litigation:8009
CORPUS_REGISTRY_PATH=data/corpus_registry.yaml

# ---- Frontend ----
NEXT_PUBLIC_AUTH_API_URL=http://localhost:8001
NEXT_PUBLIC_INGESTION_API_URL=http://localhost:8002
NEXT_PUBLIC_DOCUMENT_API_URL=http://localhost:8005
NEXT_PUBLIC_RESEARCH_API_URL=http://localhost:8004
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:8003

# ---- Text-to-Speech (Gemini) ----
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore

# ---- Web Search (Tavily) ----
# Get a free key at https://tavily.com — used for real-time legal news & SC judgments.
# If left empty, falls back to DuckDuckGo scraping (no key required, lower quality).
TAVILY_API_KEY=replace-me

# ---- Seed admin (change before production) ----
# SEED_ADMIN_EMAIL=admin@legalos.in
# SEED_ADMIN_PASSWORD=ChangeMe!2026
