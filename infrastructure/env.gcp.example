# ---------------------------------------------------------------------------
# MeraBakil — GCP production environment template
# Copy to infrastructure/.env on the VM and fill in every <CHANGE ME>.
#
# Generate fresh secrets for each environment:
#   JWT_SECRET_KEY       → openssl rand -hex 32
#   FIELD_ENCRYPTION_KEY → openssl rand -hex 64
#   POSTGRES_PASSWORD    → openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
#
# Object storage is Google Cloud Storage via the VM's attached service account
# (no keys). See infrastructure/gcp/provision-gcs.sh.
# ---------------------------------------------------------------------------

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=true

# ── Security ─────────────────────────────────────────────────────────────────
# Generate fresh values — never reuse dev secrets in production
JWT_SECRET_KEY=<CHANGE ME — openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
FIELD_ENCRYPTION_KEY=<CHANGE ME — openssl rand -hex 64>

# ── Google OAuth ──────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Add https://<YOUR_IP_OR_DOMAIN> to "Authorised JavaScript origins"
GOOGLE_OAUTH_CLIENT_ID=<CHANGE ME — from Google Cloud Console>
GOOGLE_OAUTH_CLIENT_SECRET=<CHANGE ME — from Google Cloud Console>
# Baked into the frontend at build time — must match GOOGLE_OAUTH_CLIENT_ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<CHANGE ME — same as GOOGLE_OAUTH_CLIENT_ID>

# ── PostgreSQL (Docker service "postgres" on internal network) ───────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=legalos
POSTGRES_PASSWORD=<CHANGE ME — strong password>
POSTGRES_DB=legalos

# ── Redis (Docker service "redis") ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant Cloud ─────────────────────────────────────────────────────────────
QDRANT_URL=https://aa0498cd-ec8c-47cf-a9b7-a6d2f7b1667e.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<CHANGE ME — Qdrant Cloud API key>
QDRANT_COLLECTION=legal_knowledge
QDRANT_LAWYERS_URL=https://aa0498cd-ec8c-47cf-a9b7-a6d2f7b1667e.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_LAWYERS_API_KEY=<CHANGE ME — same Qdrant API key>
QDRANT_LAWYERS_COLLECTION=lawyers

# ── OpenSearch — disabled (using Qdrant hybrid search instead) ───────────────
OPENSEARCH_URL=
OPENSEARCH_INDEX=legal_documents

# ── LLM / Embeddings (Google Gemini via OpenAI-compatible API) ───────────────
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=<CHANGE ME — Google AI Studio key>
LLM_MODEL=gemini-3.1-pro-preview
LLM_ROUTER_MODEL=gemini-3.6-flash
LLM_FAST_MODEL=gemini-3.6-flash
LLM_USE_STUB=false

EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=<CHANGE ME — same Google AI Studio key>
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
EMBEDDING_USE_STUB=false

# ── Text-to-Speech + Voice Live (Gemini) ─────────────────────────────────────
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
VOICE_LIVE_MODEL=gemini-3.1-flash-live-preview

# ── LiveKit (appointment room audio/video) ────────────────────────────────────
# Get credentials at livekit.io → Cloud
LIVEKIT_URL=<CHANGE ME — wss://your-project.livekit.cloud>
LIVEKIT_API_KEY=<CHANGE ME — LiveKit API key>
LIVEKIT_API_SECRET=<CHANGE ME — LiveKit API secret>

# ── Tavily web search (falls back to DuckDuckGo if empty) ────────────────────
TAVILY_API_KEY=<CHANGE ME — Tavily API key>

# ── GCS — Google Cloud Storage (native SDK, ADC via VM service account) ──────
# No keys: the VM runs as merabakil-storage@merabakil.iam.gserviceaccount.com
# (attach with --scopes=cloud-platform). Buckets are private; images are served
# via short-lived signed URLs.
GCS_PROJECT=merabakil
GCS_BUCKET=merabakil-documents          # private: documents + extracted text + ingested files
GCS_PUBLIC_BUCKET=merabakil-public      # avatars / profile photos (signed URLs)
# SIGNED_URL_TTL=604800                  # optional, seconds (default 7 days)

# ── Corpus registry ───────────────────────────────────────────────────────────
CORPUS_REGISTRY_PATH=data/corpus_registry.yaml

# ── Lawyer Marketplace — use PostgreSQL in production ────────────────────────
MARKETPLACE_NATIVE=false
# Replace <POSTGRES_PASSWORD> with your actual POSTGRES_PASSWORD value above
MARKETPLACE_DATABASE_URL=postgresql+asyncpg://legalos:<POSTGRES_PASSWORD>@postgres:5432/legalos
MARKETPLACE_AUTO_CONFIRM=true

# ── Inter-service URLs (Docker service names on internal network) ─────────────
AUTH_SERVICE_URL=http://auth:8000
INGESTION_SERVICE_URL=http://auth:8000
SEARCH_SERVICE_URL=http://search:8000
RESEARCH_SERVICE_URL=http://research:8000
DOCUMENT_SERVICE_URL=http://document:8000
REASONING_SERVICE_URL=http://auth:8000
DRAFTING_SERVICE_URL=http://auth:8000
CONTRACT_REVIEW_SERVICE_URL=http://auth:8000
LITIGATION_SERVICE_URL=http://auth:8000
MARKETPLACE_BASE_URL=http://marketplace:8000

# ── Frontend API base URLs ────────────────────────────────────────────────────
# In production these are served by nginx at /svc/* so leave them empty.
# Next.js falls back to relative /svc/auth, /svc/search, etc. automatically.
NEXT_PUBLIC_AUTH_API_URL=
NEXT_PUBLIC_INGESTION_API_URL=
NEXT_PUBLIC_DOCUMENT_API_URL=
NEXT_PUBLIC_RESEARCH_API_URL=
NEXT_PUBLIC_SEARCH_API_URL=
NEXT_PUBLIC_MARKETPLACE_API_URL=

# ── Analytics (baked into the frontend bundle at BUILD time) ─────────────────
# Changing any of these requires rebuilding the frontend image, not just a restart.
# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_ENABLED=false
# Microsoft Clarity — session replay + heatmaps. Opt-out model, consentv2.
# Clarity dashboard: Settings -> Cookie consent MUST be ON, masking mode Balanced.
# See docs/analytics/CLARITY_SETUP.md before enabling in production.
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLARITY_ENABLED=false

# ── Seed admin credentials ────────────────────────────────────────────────────
# Created automatically on first startup. Change the password after first login.
SEED_ADMIN_EMAIL=admin@legalos.in
SEED_ADMIN_PASSWORD=<CHANGE ME — strong password for the admin account>

# ── Neo4j — not deployed in MVP ──────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=unused-in-mvp

# ── Kafka — not deployed in MVP ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Saarthi guest trial (logged-out): kill switch for the 90s voice preview
GUEST_VOICE_ENABLED=true
# Global daily cap on guest chat messages across all IPs (cost backstop)
GUEST_GLOBAL_DAILY_BUDGET=3000
# Drop search hits below this cosine similarity (0 = off). Calibrate after loading the corpus.
SEARCH_MIN_DENSE_SCORE=0
