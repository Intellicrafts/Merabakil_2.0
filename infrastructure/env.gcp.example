# ---------------------------------------------------------------------------
# MeraBakil — GCP production environment template
# Copy to /opt/merabakil/.env on the GCE VM and fill in every <CHANGE ME>.
#
# Generate secrets:
#   JWT_SECRET_KEY       → openssl rand -hex 32
#   FIELD_ENCRYPTION_KEY → openssl rand -hex 64
#   POSTGRES_PASSWORD    → openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
#
# GCS HMAC keys:
#   gsutil hmac create merabakil-app@merabakil-prod.iam.gserviceaccount.com
# ---------------------------------------------------------------------------

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
OTEL_SDK_DISABLED=true

# ── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=<CHANGE ME — openssl rand -hex 32>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=43200
FIELD_ENCRYPTION_KEY=<CHANGE ME — openssl rand -hex 64>

# ── PostgreSQL (Docker service "postgres" on internal network) ───────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=legalos
POSTGRES_PASSWORD=<CHANGE ME — strong password>
POSTGRES_DB=legalos

# ── Redis (Docker service "redis") ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Qdrant Cloud (copy values from your local .env) ──────────────────────────
QDRANT_URL=https://aa0498cd-ec8c-47cf-a9b7-a6d2f7b1667e.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_API_KEY=<CHANGE ME — Qdrant Cloud API key>
QDRANT_COLLECTION=legal_knowledge
QDRANT_LAWYERS_URL=https://aa0498cd-ec8c-47cf-a9b7-a6d2f7b1667e.eu-central-1-0.aws.cloud.qdrant.io
QDRANT_LAWYERS_API_KEY=<CHANGE ME — same Qdrant API key>
QDRANT_LAWYERS_COLLECTION=lawyers

# ── OpenSearch — disabled (using Qdrant hybrid search instead) ───────────────
OPENSEARCH_URL=
OPENSEARCH_INDEX=legal_documents

# ── Google Gemini (copy values from your local .env) ─────────────────────────
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=<CHANGE ME — Google AI Studio key>
LLM_MODEL=gemini-3.1-pro-preview
LLM_ROUTER_MODEL=gemini-3.6-flash
LLM_USE_STUB=false

EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=<CHANGE ME — same Google AI Studio key>
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
EMBEDDING_USE_STUB=false

TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore
VOICE_LIVE_MODEL=gemini-3.1-flash-live-preview

# ── Google OAuth (optional — enables "Sign in with Google" button) ───────────
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client
# Add https://<YOUR_IP_OR_DOMAIN> to "Authorised JavaScript origins"
GOOGLE_OAUTH_CLIENT_ID=<CHANGE ME — or leave empty to disable Google Sign-In>
GOOGLE_OAUTH_CLIENT_SECRET=<CHANGE ME — or leave empty to disable Google Sign-In>
# Must match GOOGLE_OAUTH_CLIENT_ID — baked into the frontend at build time
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<CHANGE ME — same value as GOOGLE_OAUTH_CLIENT_ID>

# ── LiveKit (optional — enables video/audio in appointment rooms) ─────────────
# Get free credentials at livekit.io → Cloud
LIVEKIT_URL=<CHANGE ME — wss://your-project.livekit.cloud, or leave empty>
LIVEKIT_API_KEY=<CHANGE ME — or leave empty to disable video calls>
LIVEKIT_API_SECRET=<CHANGE ME — or leave empty to disable video calls>

# ── Tavily web search (optional — falls back to DuckDuckGo if empty) ─────────
TAVILY_API_KEY=<CHANGE ME — or leave empty to use DuckDuckGo fallback>

# ── GCS — Google Cloud Storage (S3-compatible via HMAC keys) ─────────────────
# boto3 uses the XML API endpoint — no code change required vs S3.
# Create HMAC keys: gsutil hmac create merabakil-app@merabakil-prod.iam.gserviceaccount.com
S3_ENDPOINT_URL=https://storage.googleapis.com
S3_REGION=asia-south1
S3_ACCESS_KEY=<CHANGE ME — HMAC access key>
S3_SECRET_KEY=<CHANGE ME — HMAC secret key>
S3_BUCKET=merabakil-documents

# ── Lawyer Marketplace — use PostgreSQL in production ────────────────────────
MARKETPLACE_NATIVE=false
MARKETPLACE_DATABASE_URL=postgresql+asyncpg://legalos:<POSTGRES_PASSWORD>@postgres:5432/legalos
MARKETPLACE_AUTO_CONFIRM=true

# ── Inter-service URLs (Docker network service names, port 8000) ─────────────
AUTH_SERVICE_URL=http://auth:8000
INGESTION_SERVICE_URL=http://auth:8000
SEARCH_SERVICE_URL=http://search:8000
RESEARCH_SERVICE_URL=http://research:8000
DOCUMENT_SERVICE_URL=http://auth:8000
REASONING_SERVICE_URL=http://auth:8000
DRAFTING_SERVICE_URL=http://auth:8000
CONTRACT_REVIEW_SERVICE_URL=http://auth:8000
LITIGATION_SERVICE_URL=http://auth:8000
MARKETPLACE_BASE_URL=http://marketplace:8000

# ── Neo4j — not deployed in MVP ──────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=unused-in-mvp

# ── Kafka — not deployed in MVP ──────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
